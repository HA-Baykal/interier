# ===== Безопасность =====
SESSION_SECRET=change_me_super_long_random_string
DATABASE_PATH=./data/app.json

# ===== Режим генерации =====
# demo       — локальный предпросмотр (без API)
# compatible — российский API-агрегатор с оплатой в рублях (РЕКОМЕНДУЕТСЯ для РФ),
#              сохраняет стены/окна/двери/планировку, меняет только интерьер
# replicate  — Replicate (для справки)
GENERATION_MODE=demo

# ===== compatible-агрегатор (путь №1, оплата в рублях) =====
# Эти значения также можно задать в админ-панели (/admin → Настройки).
# Провайдер: genapi (gen-api.ru, РЕКОМЕНДУЕТСЯ) | openai-compatible (provod.ai)
# genapi:  base_url="https://api.gen-api.ru", на Vercel передаётся публичная ссылка на оригинал из Blob
COMPATIBLE_PROVIDER=genapi
COMPATIBLE_BASE_URL=https://api.gen-api.ru
COMPATIBLE_API_KEY=
# Модели GenAPI (редактирование изображений, сохраняют планировку):
#   gpt-image-2  — рекомендованная;  nano-banana-pro, nano-banana
COMPATIBLE_MODEL=gpt-image-2

# ===== Replicate (модель adirik/interior-design) =====
# Получить ключ: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
REPLICATE_MODEL_OWNER=adirik
REPLICATE_MODEL_NAME=interior-design

# ===== OpenAI =====
OPENAI_API_KEY=

# ===== Together / fal.ai =====
TOGETHER_API_KEY=
FAL_API_KEY=

# ===== Админ-аккаунт (создаётся при первом запуске) =====
# Значения применяются при каждом старте: изменили пароль здесь — он обновится
# и у существующего аккаунта. Кавычки/пробелы отбрасываются автоматически.
ADMIN_EMAIL=admin@interier.ru
ADMIN_PASSWORD=admin123
# Необязательно: секрет для восстановления входа, когда админ уже существует.
# POST /api/admin/bootstrap с x-setup-token: <значение> восстановит админа из env.
# На Vercel обязательно задайте СВОЙ ADMIN_PASSWORD, не admin123.
ADMIN_SETUP_TOKEN=

# ===== Telegram: подтверждение входа (секреты только на сервере) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=interier_home_bot
# Необязательно: постоянный HTTPS origin. На Vercel по умолчанию VERCEL_BRANCH_URL.
AUTH_PUBLIC_URL=
# Для защищённого Preview Vercel сам задаёт VERCEL_AUTOMATION_BYPASS_SECRET
# после Settings → Deployment Protection → Protection Bypass for Automation.
# Значение не копировать в клиент/чат. После создания нужен Redeploy.
VK_ACCESS_TOKEN=

# ===== Vercel / облачное хранилище (serverless) =====
# Без этих переменных приложение работает на локальном файле (data/app.json) и
# подходит для разработки. На Vercel (эфимерная ФС) обязательны:
#   БД (вся база хранится как один документ) — Upstash Redis / Vercel KV:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#   (legacy Vercel KV, если уже подключён ранее)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#   Фото (загрузки + результаты) — Vercel Blob, Public store:
# На Vercel подключение создаёт BLOB_STORE_ID; SDK использует управляемый OIDC.
# VERCEL_OIDC_TOKEN не создавайте и не копируйте вручную.
BLOB_STORE_ID=
# Старый способ / локальный запуск вне Vercel (вместо OIDC):
BLOB_READ_WRITE_TOKEN=

# Не задавайте REDIS_DB_KEY=app:db для Preview: по умолчанию ветки изолированы.
# REDIS_DB_KEY=
# Подробная инструкция по панели: docs/VERCEL-SETUP.md
# Redis-пара и подключение Blob нужны в Preview; после изменения — Redeploy.
# Если COMPATIBLE_* доступны только Production, добавьте Preview в их Environments.
# Blob должен быть Public. Секреты никогда не называйте NEXT_PUBLIC_... .

# ===== Безопасность =====
SESSION_SECRET=change_me_super_long_random_string
DATABASE_PATH=./data/app.json

# ===== Режим генерации =====
# demo       — локальный предпросмотр (без API)
# compatible — российский API-агрегатор с оплатой в рублях (РЕКОМЕНДУЕТСЯ для РФ),
#              сохраняет стены/окна/двери/планировку, меняет только интерьер
# replicate  — Replicate (для справки)
GENERATION_MODE=demo

# ===== compatible-агрегатор (путь №1, оплата в рублях) =====
# Эти значения также можно задать в админ-панели (/admin → Настройки).
# Провайдер: genapi (gen-api.ru, РЕКОМЕНДУЕТСЯ) | openai-compatible (provod.ai)
# genapi:  base_url="https://api.gen-api.ru", на Vercel передаётся публичная ссылка на оригинал из Blob
COMPATIBLE_PROVIDER=genapi
COMPATIBLE_BASE_URL=https://api.gen-api.ru
COMPATIBLE_API_KEY=
# Модели GenAPI (редактирование изображений, сохраняют планировку):
#   gpt-image-2  — рекомендованная;  nano-banana-pro, nano-banana
COMPATIBLE_MODEL=gpt-image-2

# ===== Replicate (модель adirik/interior-design) =====
# Получить ключ: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
REPLICATE_MODEL_OWNER=adirik
REPLICATE_MODEL_NAME=interior-design

# ===== OpenAI =====
OPENAI_API_KEY=

# ===== Together / fal.ai =====
TOGETHER_API_KEY=
FAL_API_KEY=

# ===== Админ-аккаунт (создаётся при первом запуске) =====
# Значения применяются при каждом старте: изменили пароль здесь — он обновится
# и у существующего аккаунта. Кавычки/пробелы отбрасываются автоматически.
ADMIN_EMAIL=admin@interier.ru
ADMIN_PASSWORD=admin123
# Необязательно: секрет для восстановления входа, когда админ уже существует.
# POST /api/admin/bootstrap с x-setup-token: <значение> восстановит админа из env.
# На Vercel обязательно задайте СВОЙ ADMIN_PASSWORD, не admin123.
ADMIN_SETUP_TOKEN=

# ===== Публичный адрес (обязателен для ботов и мини-приложений) =====
# Боты отправляют ссылки и картинки — они должны быть доступны из мессенджера.
# На Vercel постоянным адресом считается VERCEL_BRANCH_URL; AUTH_PUBLIC_URL
# задают, только если нужен свой домен.
PUBLIC_BASE_URL=
AUTH_PUBLIC_URL=

# ===== Telegram: бот = вход + приложение =====
# 1) @BotFather: /newbot → скопировать токен. /setprivacy → Disable.
# 2) ADMIN_TELEGRAM_ID — ваш числовой id (узнать: @userinfobot). Этот аккаунт
#    автоматически получает админку в боте и в мини-приложении.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=interier_home_bot
# URL мини-приложения = публичный адрес + /app. Кнопка меню ставится этим же
# адресом автоматически при подключении бота (админка → «Боты»).
TELEGRAM_MINI_APP_URL=
# Секрет вебхука. Для входа через Telegram секрет выводится из токена сам
# (src/lib/telegram/config.ts); здесь можно задать свой, чтобы оба транспорта
# принимали один и тот же заголовок X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# Для защищённого Preview Vercel сам задаёт VERCEL_AUTOMATION_BYPASS_SECRET
# после Settings → Deployment Protection → Protection Bypass for Automation.
# Значение не копировать в клиент/чат. После создания нужен Redeploy.
# Канал для «+1 кредит за подписку» (не путать с ботом): @username или -1001234567890
TELEGRAM_CHANNEL_ID=

# ===== VK: бот сообщества =====
# Ключ сообщества: Сообщество → Управление → Работа с API → «Ключи доступа»
# (права: сообщения + управление сообществом). Callback API — отдельный сервер,
# существующие интеграции (например Avito) не трогаем.
VK_ACCESS_TOKEN=
VK_GROUP_ID=
# Callback API: секретный ключ + confirmation token из настроек eventos VK.
VK_CALLBACK_SECRET=
VK_CONFIRMATION_TOKEN=
# Проверка подписи callbacks (выключите только при отладке: 0).
VK_VERIFY_SIGNATURE=1
# VK Mini App (опционально): app id и статический секрет входа.
VK_MINI_APP_ID=
VK_APP_VERIFY_TOKEN=

# ===== MAX: бот (мессенджер MAX) =====
# business.max.ru → self → Чат-боты → Расширенные настройки → токен.
MAX_BOT_TOKEN=
# platform-api2.max.ru — актуальный адрес; старый platform-api.max.ru остаётся запасным.
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_WEBHOOK_SECRET=

# ===== Транспорт ботов =====
# Вебхуки — основной вариант. Если публичного HTTPS нет, запустите воркер
# long-polling: npm run bots:poll (он дергает POST /api/bots/poll ниже).
BOT_POLL_SECRET=
# 1 = разрешить симулятор диалога (POST /api/bots/simulator и «Тест бота» в админке).
# Держите включённым только на время проверки.
BOTS_SIMULATOR=0

# ===== Список деталей интерьера → магазины =====
# Магазины через запятую, порядок = приоритет (полный список — в src/lib/marketplaces.ts)
SHOPPING_MARKETPLACES=ozon,yandex_market,leroy_merlin
# Партнёрские/UTM метки, добавляемые к каждой ссылке (монетизация).
SHOPPING_EXTRA_PARAMS=
# hotspots (точки на фото, нужны координаты от ИИ) | list (список со ссылками)
SHOPPING_DEFAULT_MODE=hotspots
# 1 = показывать список покупок в публичной галерее.
SHOPPING_PUBLIC_LINKS=0

# ===== ИИ-распознаватель деталей (координаты для хотспотов) =====
# inherit = тот же агрегатор и ключ, что у генерации. Модель обязана быть мультимодальной.
VISION_PROVIDER=inherit
VISION_BASE_URL=https://api.gen-api.ru
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini

# ===== Vercel / облачное хранилище (serverless) =====
# Без этих переменных приложение работает на локальном файле (data/app.json) и
# подходит для разработки. На Vercel (эфимерная ФС) обязательны:
#   БД (вся база хранится как один документ) — Upstash Redis / Vercel KV:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#   (legacy Vercel KV, если уже подключён ранее)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#   Фото (загрузки + результаты) — Vercel Blob, Public store:
# На Vercel подключение создаёт BLOB_STORE_ID; SDK использует управляемый OIDC.
# VERCEL_OIDC_TOKEN не создавайте и не копируйте вручную.
BLOB_STORE_ID=
# Старый способ / локальный запуск вне Vercel (вместо OIDC):
BLOB_READ_WRITE_TOKEN=

# Не задавайте REDIS_DB_KEY=app:db для Preview: по умолчанию ветки изолированы.
# REDIS_DB_KEY=
# Подробная инструкция по панели: docs/VERCEL-SETUP.md
# Redis-пара и подключение Blob нужны в Preview; после изменения — Redeploy.
# Если COMPATIBLE_* доступны только Production, добавьте Preview в их Environments.
# Blob должен быть Public. Секреты никогда не называйте NEXT_PUBLIC_... .

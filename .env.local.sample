# Безопасность
SESSION_SECRET=change_me_super_long_random_string
DATABASE_PATH=./data/app.json

# Режим генерации: demo | compatible | replicate
# compatible — российский API-агрегатор с оплатой в рублях (сохраняет планировку)
GENERATION_MODE=compatible

# compatible-агрегатор (gen-api.ru — оплата в рублях, рекомендуется)
# Провайдер: genapi | openai-compatible
COMPATIBLE_PROVIDER=genapi
COMPATIBLE_BASE_URL=https://api.gen-api.ru
COMPATIBLE_API_KEY=
# Ключ задайте здесь локально или в Environment Variables Vercel / админке.
# Модели GenAPI (редактирование, сохраняют планировку): gpt-image-2 / nano-banana-pro / nano-banana
COMPATIBLE_MODEL=gpt-image-2

# Replicate
REPLICATE_API_TOKEN=
# OpenAI
OPENAI_API_KEY=
# Together / fal.ai
TOGETHER_API_KEY=
FAL_API_KEY=

# Telegram / VK (подключим позже)
TELEGRAM_BOT_TOKEN=
VK_ACCESS_TOKEN=

# Vercel: база (весь JSON-документ) — Upstash Redis / Vercel KV; фото — Vercel Blob.
# На Vercel (эфимерная ФС) — обязательно. Локально можно оставить пустыми (файл).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel: BLOB_STORE_ID + управляемый SDK OIDC, без ручного временного токена.
BLOB_STORE_ID=
# Альтернативный старый способ / локальное подключение:
BLOB_READ_WRITE_TOKEN=

# Перед публичным запуском задайте собственные учётные данные администратора.
ADMIN_EMAIL=admin@interier.ru
ADMIN_PASSWORD=admin123
# Пошаговая настройка Preview/Production: docs/VERCEL-SETUP.md
